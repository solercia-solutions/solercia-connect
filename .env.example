# Copy values only into a secret-aware local environment. Never commit real credentials.
# Solercia Connect does not load a cwd .env automatically. To use an environment file, export:
SOLERCIA_CONNECT_ENV_FILE=

# Microsoft public/native OAuth application (device authorization; no client secret required).
SOLERCIA_CONNECT_MICROSOFT_CLIENT_ID=
SOLERCIA_CONNECT_MICROSOFT_TENANT=organizations

# Google OAuth Desktop application. Some Desktop client configurations require the secret.
SOLERCIA_CONNECT_GOOGLE_CLIENT_ID=
SOLERCIA_CONNECT_GOOGLE_CLIENT_SECRET=

# Microsoft browser route availability only. Every attempt still requires --allow-browser-fallback.
SOLERCIA_CONNECT_BROWSER_FALLBACK=false
SOLERCIA_CONNECT_M365_PROFILE_DIR=

# Loopback FastAPI service. Generate a high-entropy local API key outside source control.
SOLERCIA_CONNECT_API_HOST=127.0.0.1
SOLERCIA_CONNECT_API_PORT=8765
SOLERCIA_CONNECT_API_KEY=
SOLERCIA_CONNECT_OUTPUT_DIR=
# Opt-in: let the loopback service start the supervised Microsoft browser login over HTTP.
# Effective only with SOLERCIA_CONNECT_BROWSER_FALLBACK=true and an API key. Default: false.
SOLERCIA_CONNECT_HTTP_INTERACTIVE_LOGIN=false

# Development bootstrap only. Prefer connect + secure keyring token storage.
SOLERCIA_CONNECT_MICROSOFT_ACCESS_TOKEN=
SOLERCIA_CONNECT_MICROSOFT_EXPECTED_ACCOUNT=
SOLERCIA_CONNECT_GOOGLE_ACCESS_TOKEN=
SOLERCIA_CONNECT_GOOGLE_EXPECTED_ACCOUNT=
# Backward-compatible aliases: MS_GRAPH_ACCESS_TOKEN, MS_GRAPH_EXPECTED_ACCOUNT,
# GOOGLE_ACCESS_TOKEN, GOOGLE_EXPECTED_ACCOUNT.
GOOGLE_CALENDAR_ID=primary

# Jira Cloud compatibility.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_EXPECTED_ACCOUNT_ID=

# GLPI REST compatibility.
GLPI_BASE_URL=https://glpi.example.gov.co/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Opt-in live contracts. Use dedicated accounts and an exact end-exclusive range.
SOLERCIA_CONNECT_LIVE=0
SOLERCIA_CONNECT_LIVE_TYPE=
SOLERCIA_CONNECT_LIVE_ACCOUNT=
SOLERCIA_CONNECT_LIVE_START=2026-08-01T00:00:00-05:00
SOLERCIA_CONNECT_LIVE_END=2026-09-01T00:00:00-05:00
SOLERCIA_CONNECT_LIVE_MEETING_ID=
